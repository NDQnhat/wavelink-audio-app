# ==============================================================================
# WAVELINK FRONTEND - MÔI TRƯỜNG CỤC BỘ (LOCAL DEVELOPMENT)
# Sao chép thành file `frontend/.env` khi phát triển giao diện
# ==============================================================================

# URL API Backend phục vụ phát triển cục bộ:
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Tùy chọn: Trỏ frontend local tới Backend Render hoặc VPS:
# VITE_API_BASE_URL=https://wavelink-audio-app.onrender.com
# VITE_API_BASE_URL=https://api.yourdomain.com/api/v1

# Cấu hình phân trang giao diện
VITE_ITEMS_PER_PAGE=12
