# ==============================================================================
# WAVELINK - MÔI TRƯỜNG TỰ HOST TRÊN UBUNTU SERVER (2 CONTAINERS: BACKEND + SQL)
# Kiến trúc:
#   1. Frontend: Triển khai trên Vercel Edge (0% tải server, CDN toàn cầu)
#   2. Ubuntu Server: Chạy đúng 2 container qua docker-compose.yml:
#      - Container 1: Backend API (Golang Gin)
#      - Container 2: MySQL 8.0 Low-Memory (RAM ~150MB-180MB)
#
# Cách sử dụng trên Ubuntu Server:
#   cp env.vps.example env.vps
#   docker compose --env-file env.vps up -d
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH HỆ THỐNG & BẢO MẬT BACKEND
# ------------------------------------------------------------------------------
APP_ENV=production
PORT=8080
BACKEND_PORT=8080
GIN_MODE=release

# Khóa JWT bí mật (BẮT BUỘC ĐỔI sang chuỗi ngẫu nhiên dài >= 32 ký tự trước khi chạy!)
JWT_SECRET=ThayDoiKhoaBaoMatNayBangChuoiNgauNhienDaiItNhat32KyTu2026!

# CORS Origins: Cho phép Frontend từ Vercel và tên miền VPS gọi vào API
ALLOWED_ORIGINS=https://*.vercel.app,https://your-wavelink-app.vercel.app,https://api.yourdomain.com

# Pre-built Image kéo từ GitHub Container Registry (ghcr.io)
# Giúp VPS 1GB RAM không phải tốn CPU/RAM để compile code:
BACKEND_IMAGE=ghcr.io/tranducanh3103/wavelink-backend:latest

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH MYSQL 8.0 CHẠY TRONG DOCKER (MẠNG NỘI BỘ BẢO MẬT)
# ------------------------------------------------------------------------------
DB_DRIVER=mysql

# Chuỗi kết nối Backend -> MySQL qua tên service 'db' trong mạng nội bộ docker
DB_SOURCE=wavelink:wavelinkpass@tcp(db:3306)/audio_app?charset=utf8mb4&parseTime=True&loc=Local

# Mật khẩu quản trị và tài khoản MySQL
MYSQL_ROOT_PASSWORD=ThayBangMatKhauRootSieuKho2026!
MYSQL_DATABASE=audio_app
MYSQL_USER=wavelink
MYSQL_PASSWORD=wavelinkpass

# BẢO MẬT: Chỉ mở cổng MySQL trên localhost (127.0.0.1), KHÔNG mở ra Internet
MYSQL_BIND_IP=127.0.0.1
MYSQL_PORT=3306

# Tinh chỉnh thông số bộ nhớ MySQL cho VPS 1GB - 2GB RAM
MYSQL_BUFFER_POOL_SIZE=64M
MYSQL_MAX_CONNECTIONS=35

# ------------------------------------------------------------------------------
# 3. TỐI ƯU HÓA POOL KẾT NỐI CHO SERVER NHỎ (VPS 1GB - 2GB RAM)
# ------------------------------------------------------------------------------
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=15
DB_CONN_MAX_IDLE_TIME_MINUTES=3

# ------------------------------------------------------------------------------
# 4. TÀI KHOẢN QUẢN TRỊ ADMIN KHỞI TẠO (SEEDING)
# ------------------------------------------------------------------------------
SEED_DATA=true
ADMIN_USERNAME=admin_vps
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=MatKhauAdminSieuKhoVPS2026!

# ------------------------------------------------------------------------------
# 5. THUẬT TOÁN PHÂN ĐOẠN TẬP & THANH TOÁN VIETQR DEMO
# ------------------------------------------------------------------------------
EPISODE_BLOCK_SECONDS=14400
VIETQR_BANK_NAME=MB Bank
VIETQR_ACCOUNT_NUMBER=0987654321
VIETQR_ACCOUNT_NAME=COMIC AUDIO HUB
VIETQR_NOTE_PREFIX=VIP

# ------------------------------------------------------------------------------
# 6. HƯỚNG DẪN CẤU HÌNH FRONTEND TRÊN VERCEL KHI DÙNG VỚI VPS:
# ------------------------------------------------------------------------------
# Trỏ biến môi trường trên Vercel Dashboard về Domain có SSL của VPS (hoặc Cloudflare Tunnel):
# VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
# VITE_ITEMS_PER_PAGE=12
