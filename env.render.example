# ==============================================================================
# WAVELINK - MÔI TRƯỜNG CLOUD TÁCH BIỆT (PRODUCTION CLOUD)
# Kiến trúc:
#   1. Frontend: Vercel Global Edge CDN
#   2. Backend API: Render Web Service (Docker Runtime)
#   3. Database: Aiven Cloud Managed MySQL (Bật TLS/SSL)
#
# Sao chép các biến bên dưới vào trang quản trị tương ứng (Render / Vercel Dashboard)
# ==============================================================================

# ==============================================================================
# PHẦN A: CẤU HÌNH BACKEND TRÊN RENDER
# (Nhập vào: Render Dashboard -> Web Service -> Environment Variables)
# ==============================================================================

APP_ENV=production
PORT=8080
GIN_MODE=release

# CORS: Cho phép tên miền Frontend từ Vercel gọi API
ALLOWED_ORIGINS=https://*.vercel.app,https://your-wavelink-app.vercel.app

# Khóa JWT bí mật (BẮT BUỘC ĐỔI sang chuỗi bảo mật ngẫu nhiên dài >= 32 ký tự trên Render!)
JWT_SECRET=ThayDoiKhoaBaoMatNayBangChuoiNgauNhienDaiItNhat32KyTu2026!

# --- KẾT NỐI CƠ SỞ DỮ LIỆU AIVEN MYSQL (YÊU CẦU SSL/TLS) ---
DB_DRIVER=mysql

# DSN chuẩn cho Golang (database/sql, GORM, go-sql-driver/mysql)
DB_SOURCE="avnadmin:your_aiven_password@tcp(your-aiven-db-host.aivencloud.com:17460)/defaultdb?charset=utf8mb4&parseTime=true&loc=Local&tls=skip-verify"

# --- TỐI ƯU HÓA POOL CHO CLOUD MYSQL (AIVEN / RENDER) ---
# Tránh lỗi đứt kết nối do tường lửa NAT của Render/Aiven ngắt kết nối rảnh (idle timeout):
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=15
DB_CONN_MAX_IDLE_TIME_MINUTES=3

# --- CẤU HÌNH TÀI KHOẢN ADMIN BẢO MẬT & SEEDING ---
SEED_DATA=true
ADMIN_USERNAME=admin_production
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=MatKhauAdminSieuKhoDungChoRender2026!

# --- LOGIC THỜI LƯỢNG TẬP VÀ THANH TOÁN VIETQR ---
EPISODE_BLOCK_SECONDS=14400
VIETQR_BANK_NAME=MB Bank
VIETQR_ACCOUNT_NUMBER=0987654321
VIETQR_ACCOUNT_NAME=COMIC AUDIO HUB
VIETQR_NOTE_PREFIX=VIP

# ==============================================================================
# PHẦN B: CẤU HÌNH FRONTEND TRÊN VERCEL
# (Nhập vào: Vercel Dashboard -> Project Settings -> Environment Variables)
# ==============================================================================

# URL API Backend trỏ tới dịch vụ Render:
VITE_API_BASE_URL=https://wavelink-backend-api.onrender.com/api/v1

# Cấu hình phân trang danh sách truyện và thông báo trên Vercel:
VITE_ITEMS_PER_PAGE=12
