# ==============================================================================
# WAVELINK - MÔI TRƯỜNG FULLSTACK TRÊN UBUNTU SERVER (3 CONTAINERS: FE + BE + DB)
# Kiến trúc:
#   1. Frontend: Nginx Reverse Proxy (Chạy trong Docker container)
#   2. Backend API: Golang Gin (Chạy trong Docker container)
#   3. Database: MySQL 8.0 Low-Memory (Chạy trong Docker container)
#
# Cách sử dụng trên Ubuntu Server:
#   cp env.fullstack.example env.vps
#   docker compose --env-file env.vps --profile fullstack up -d
# ==============================================================================

# Kích hoạt profile fullstack để bật cả container Frontend Nginx:
COMPOSE_PROFILES=fullstack

APP_ENV=production
PORT=8080
BACKEND_PORT=8080
FRONTEND_PORT=80
GIN_MODE=release

JWT_SECRET=ThayDoiKhoaBaoMatNayBangChuoiNgauNhienDaiItNhat32KyTu2026!
ALLOWED_ORIGINS=*

BACKEND_IMAGE=ghcr.io/tranducanh3103/wavelink-backend:latest
FRONTEND_IMAGE=ghcr.io/tranducanh3103/wavelink-frontend:latest

# Cấu hình build args Frontend nếu build trực tiếpcho 
VITE_API_BASE_URL=/api/v1
VITE_ITEMS_PER_PAGE=12

# Database MySQL nội bộ
DB_DRIVER=mysql
DB_SOURCE=wavelink:wavelinkpass@tcp(db:3306)/audio_app?charset=utf8mb4&parseTime=True&loc=Local
MYSQL_ROOT_PASSWORD=ThayBangMatKhauRootSieuKho2026!
MYSQL_DATABASE=audio_app
MYSQL_USER=wavelink
MYSQL_PASSWORD=wavelinkpass
MYSQL_BIND_IP=127.0.0.1
MYSQL_PORT=3306

MYSQL_BUFFER_POOL_SIZE=64M
MYSQL_MAX_CONNECTIONS=35

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=15
DB_CONN_MAX_IDLE_TIME_MINUTES=3

SEED_DATA=true
ADMIN_USERNAME=admin_fullstack
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=MatKhauAdminFullstack2026!

EPISODE_BLOCK_SECONDS=14400
VIETQR_BANK_NAME=MB Bank (Quân Đội)
VIETQR_ACCOUNT_NUMBER=0987654321
VIETQR_ACCOUNT_NAME=COMIC AUDIO HUB
VIETQR_NOTE_PREFIX=VIP
