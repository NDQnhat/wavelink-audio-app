# ==============================================================================
# WAVELINK - MÔI TRƯỜNG PHÁT TRIỂN CỤC BỘ (LOCAL DEVELOPMENT)
# Hướng dẫn: Sao chép thành `env.dev` hoặc `.env` để chạy dự án
#   cp env.dev.example env.dev
# Lệnh chạy với Docker Compose:
#   docker compose --env-file env.dev up -d
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH DỊCH VỤ CHUNG
# ------------------------------------------------------------------------------
APP_ENV=development
PORT=8080
BACKEND_PORT=8080
FRONTEND_PORT=5173
GIN_MODE=debug
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8080

# Khóa JWT bí mật phục vụ kiểm thử cục bộ
JWT_SECRET=wavelink-dev-secret-jwt-key-local-testing-2026

# Thư mục chứa giao diện tĩnh (khi chạy Go server phục vụ trực tiếp)
STATIC_DIR=../frontend

# ------------------------------------------------------------------------------
# 2. CƠ SỞ DỮ LIỆU LOCAL
# ------------------------------------------------------------------------------
# Sử dụng MySQL Local (Bật container `db` trong docker-compose)
# DB_DRIVER=mysql
# DB_SOURCE=wavelink:wavelinkpass@tcp(127.0.0.1:3306)/audio_app?charset=utf8mb4&parseTime=True&loc=Local
# MYSQL_ROOT_PASSWORD=
# MYSQL_DATABASE=audio_app
# MYSQL_USER=root
# MYSQL_PASSWORD=310306
# MYSQL_BIND_IP=127.0.0.1
# MYSQL_PORT=3306

# ------------------------------------------------------------------------------
# 3. POOL KẾT NỐI DATABASE CHO MÁY DEV
# ------------------------------------------------------------------------------
DB_MAX_OPEN_CONNS=15
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=15
DB_CONN_MAX_IDLE_TIME_MINUTES=3

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH TÀI KHOẢN ADMIN VÀ DỮ LIỆU MẪU (SEEDING)
# ------------------------------------------------------------------------------
SEED_DATA=true
ADMIN_USERNAME=admin123
ADMIN_EMAIL=admin123@audioapp.com
ADMIN_PASSWORD=admin123

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH FRONTEND REACT VITE
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_ITEMS_PER_PAGE=12

# ------------------------------------------------------------------------------
# 6. CẤU HÌNH THANH TOÁN VIETQR & LOGIC NỘI DUNG
# ------------------------------------------------------------------------------
EPISODE_BLOCK_SECONDS=14400
VIETQR_BANK_NAME=MB Bank
VIETQR_ACCOUNT_NUMBER=0987654321
VIETQR_ACCOUNT_NAME=COMIC AUDIO HUB
VIETQR_NOTE_PREFIX=VIP
