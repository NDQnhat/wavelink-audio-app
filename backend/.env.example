# Cấu hình YouTube Audio Library Backend
PORT=8080
ALLOWED_ORIGINS=*
JWT_SECRET=super-secret-key-change-in-prod-audio-app-2026
STATIC_DIR=../frontend
EPISODE_BLOCK_SECONDS=14400

# Lựa chọn Cơ sở Dữ liệu: 'sqlite' hoặc 'mysql'
DB_DRIVER=sqlite
DB_SOURCE=audio_library.db

# Nếu sử dụng MySQL 8.x:
# DB_DRIVER=mysql
# DB_SOURCE=root:your_password@tcp(127.0.0.1:3306)/audio_library?charset=utf8mb4&parseTime=True&loc=Local

# Cấu hình thông tin tài khoản nhận chuyển khoản VietQR
VIETQR_BANK_NAME=MB Bank (Quân Đội)
VIETQR_ACCOUNT_NUMBER=0987654321
VIETQR_ACCOUNT_NAME=COMIC AUDIO HUB
VIETQR_NOTE_PREFIX=VIP
