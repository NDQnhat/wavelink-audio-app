# ==============================================================================
# WAVELINK BACKEND - MÔI TRƯỜNG CỤC BỘ (LOCAL DEVELOPMENT)
# Sao chép thành file `backend/.env` khi phát triển tính năng cục bộ
# ==============================================================================

APP_ENV=development
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
JWT_SECRET=dev-secret-key-do-not-use-in-production-wavelink-2026
STATIC_DIR=../frontend
EPISODE_BLOCK_SECONDS=14400

# ------------------------------------------------------------------------------
# LỰA CHỌN CƠ SỞ DỮ LIỆU LOCAL
# ------------------------------------------------------------------------------

# Tùy chọn 2: MySQL Local (Nếu bạn muốn kiểm thử sát với môi trường Production)
DB_DRIVER=mysql
DB_SOURCE=root:rootpassword@tcp(127.0.0.1:3306)/audio_app?charset=utf8mb4&parseTime=True&loc=Local

# Tùy chọn 3: Kết nối trực tiếp tới Aiven Cloud MySQL từ máy Dev
# DB_DRIVER=mysql
# DB_SOURCE=avnadmin:your_aiven_password@tcp(your-aiven-db-host.aivencloud.com:17460)/defaultdb?charset=utf8mb4&parseTime=True&loc=Local&tls=skip-verify

# ------------------------------------------------------------------------------
# POOL KẾT NỐI DATABASE CHO MÁY DEV
# ------------------------------------------------------------------------------
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=15
DB_CONN_MAX_IDLE_TIME_MINUTES=3

# ------------------------------------------------------------------------------
# CẤU HÌNH TÀI KHOẢN ADMIN VÀ SEEDING DỮ LIỆU
# ------------------------------------------------------------------------------
SEED_DATA=true
ADMIN_USERNAME=admin123
ADMIN_EMAIL=admin123@audioapp.com
ADMIN_PASSWORD=admin123

# ------------------------------------------------------------------------------
# CẤU HÌNH THANH TOÁN VIETQR DEMO
# ------------------------------------------------------------------------------
VIETQR_BANK_NAME=MB Bank (Quân Đội)
VIETQR_ACCOUNT_NUMBER=0987654321
VIETQR_ACCOUNT_NAME=COMIC AUDIO HUB
VIETQR_NOTE_PREFIX=VIP

# Google OAuth 2.0 Client (WaveLink)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
